{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(docker build *)",
      "Bash(docker run *)",
      "Bash(docker rm *)",
      "Bash(docker ps *)",
      "Bash(docker logs *)",
      "Bash(docker images *)",
      "Bash(docker compose -f docker-compose.dev.yml *)",
      "Bash(curl -s *)",
      "Bash(curl -fsS *)",
      "Bash(curl -sI *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(bash -n *)",
      "Bash(shellcheck *)",
      "Bash(python3 scripts/check_seo_agents.py*)",
      "Bash(python3 scripts/check_responsive.py*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(gh workflow run *)",
      "Edit(./.github/workflows/**)",
      "Edit(./deploy/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./certbot/**)",
      "Read(~/.ssh/**)",
      "Read(**/*.pem)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(rm -rf *)"
    ]
  }
}
